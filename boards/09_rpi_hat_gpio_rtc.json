        "GPA0":1,"GPA1":2,"GPA2":3,"GPA3":4,"GPA4":5,"GPA5":6,"GPA6":7,"GPA7":8,
        "GPB0":9,"GPB1":10,"GPB2":11,"GPB3":12,"GPB4":13,"GPB5":14,"GPB6":15,"GPB7":16,
        "VDD":17,"VSS":18,"SDA":19,"SCL":20,"NC":21,"INTB":22,
