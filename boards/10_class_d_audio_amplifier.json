      "pins": {
        "LOUT+": 1, "LOUT-": 2, "MUTE": 3, "ROUT-": 4,
        "ROUT+": 5, "VDD": 6, "SD_N": 7,
        "RINP": 8, "RINN": 9, "LINN": 10, "LINP": 11,
        "GND1": 12, "GND2": 13, "BYPASS": 14
      }
    },
    {
      "id": "RV1",
      "type": "potentiometer_log_10k",
      "label": "VOL L",
      "position": { "x": 3, "y": 4 },
      "pins": { "CCW": 1, "WIPER": 2, "CW": 3 }
    },
    {
      "id": "RV2",
      "type": "potentiometer_log_10k",
      "label": "VOL R",
      "position": { "x": 3, "y": 7 },
      "pins": { "CCW": 1, "WIPER": 2, "CW": 3 }
    },
    {
